# Rust build artefacts
/target/
**/*.rs.bk
*.rlib
*.prof*

# IDE / editor
.idea/
.vscode/
*.swp
*.tmp

# OS
.DS_Store
Thumbs.db

# Local secrets / env overrides
.env
.env.*
!.env.example

# Cargo lock for libraries (workspace binary `cargo` keeps the lockfile in version control)
# Uncomment if the project is ever split into publishable sub-crates:
# Cargo.lock

# Generated dependency-graph snapshots (run `graphify update .` to refresh)
graphify-out/

# Scratch / agent session artefacts
.commandcode/
.specify/
.agents/
.prompts/
.omo/
.dsh/

# Local compiled test binaries (rebuilt via cargo; never commit)
test_unwrap_or

# Large benchmark edge lists (regenerate via LFR harness; small JSON summaries stay tracked)
benchmarks/*.edges

# opencode scaffolding dependencies (commands/*.md stay tracked; deps not)
.opencode/node_modules/
